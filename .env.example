# Copier en `.env` à côté de docker-compose.yml et remplir. Ne jamais commiter le .env.

# Token du bot (portail développeur Discord > Application > Bot > Reset Token)
DISCORD_TOKEN=

# ID du serveur Discord de la guilde (clic droit sur le serveur > Copier l'identifiant).
# Renseigné : les commandes slash apparaissent immédiatement. À 0 : enregistrement global (~1 h).
DISCORD_GUILD_ID=0

# Token partagé de lecture pour GET /api/v1/export (le même pour tous les compagnons).
# En générer un : openssl rand -hex 24
API_GUILD_TOKEN=
