# Copier en `.env` à côté de docker-compose.yml et remplir. Ne jamais commiter le .env.

# Token du bot (portail développeur Discord > Application > Bot > Reset Token)
DISCORD_TOKEN=

# IDs des serveurs Discord où activer les commandes, séparés par des virgules
# (clic droit sur le serveur > Copier l'identifiant du serveur).
# Test puis prod = ajouter l'ID du serveur de guilde à la liste, ex. "111,222".
# Vide : enregistrement global (~1 h de propagation).
DISCORD_GUILD_IDS=

# Token partagé de lecture pour GET /api/v1/export (le même pour tous les compagnons).
# En générer un : openssl rand -hex 24
API_GUILD_TOKEN=

# Nom EXACT de la guilde en jeu. Les personnages scannés hors de cette guilde
# sont rejetés à l'ingestion (protection des rerolls). Vide = pas de filtrage.
GUILD_NAME=
