# Copier en `.env` à côté de docker-compose.yml et remplir. Ne jamais commiter le .env.

# Token du bot (portail développeur Discord > Application > Bot > Reset Token).
DISCORD_TOKEN=

# Développement uniquement : IDs de serveurs Discord où enregistrer les commandes
# immédiatement (séparés par des virgules). Vide en production : commandes
# globales, disponibles sur tout serveur qui invite le bot (~1 h de propagation).
DISCORD_GUILD_IDS=

# Adresse publique de l'API (mise dans les packs générés) et du site (liens du bot).
API_PUBLIC_URL=https://gp.warpvault.com
SITE_BASE_URL=https://gp.warpvault.com

# Reprise de la guilde d'avant Guildkeep (facultatif) : au démarrage, cette guilde
# est créée avec ce token, et les packs déjà installés continuent de fonctionner.
# Les nouvelles guildes, elles, se créent sur Discord avec /gkeep-setup.
API_GUILD_TOKEN=
GUILD_NAME=
# ID du serveur Discord de cette guilde (clic droit sur le serveur > Copier l'identifiant).
GUILD_DISCORD_SERVER_ID=
