<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- Pas d'InvariantGlobalization : Discord.Net charge la culture du
		     serveur Discord (preferred_locale) et planterait en mode invariant. -->
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Discord.Net" Version="3.*" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.*" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.*">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

</Project>
