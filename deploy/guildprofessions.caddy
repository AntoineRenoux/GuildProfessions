# Guildkeep : site, API, bot et packs.
guildkeep.warpvault.com {
	# L'ancienne page FORMER HOPE n'est servie que sur son propre domaine.
	@formerhope path /formerhope /formerhope/*
	respond @formerhope 404
	reverse_proxy guildprofessions-server-1:8080
}

# Ancienne adresse de Guildkeep : redirigée vers la nouvelle (308 : garde la
# méthode, les envois POST du compagnon suivent).
gp.warpvault.com {
	redir https://guildkeep.warpvault.com{uri} 308
}

# Ancienne page FORMER HOPE (version GuildProfessions 1.0.38), servie telle quelle
# depuis wwwroot/formerhope ; l'API et les téléchargements passent sans réécriture.
formerhopesupport.warpvault.com {
	@page not path /api/* /healthz /downloads/* /formerhope/*
	rewrite @page /formerhope{path}
	reverse_proxy guildprofessions-server-1:8080
}
