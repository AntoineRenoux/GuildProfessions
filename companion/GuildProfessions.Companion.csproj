<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- WinExe : pas de console sous Windows (le compagnon vit dans une icône de notification). -->
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<InvariantGlobalization>true</InvariantGlobalization>
		<AssemblyName>GuildkeepCompanion</AssemblyName>
		<!-- Remplacée au packaging par 1.0.<nombre de commits> (scripts/package-companion.sh). -->
		<Version>1.0.0</Version>
		<!-- Fichier unique : les bibliothèques natives de l'icône (Skia, HarfBuzz, Avalonia) voyagent dans
		     l'exécutable, que la mise à jour automatique remplace seul. -->
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
	</PropertyGroup>

	<ItemGroup>
	  <PackageReference Include="Avalonia" Version="12.1.6" />
	  <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Assets/tray-icon.png" LogicalName="GuildProfessions.Companion.Assets.tray-icon.png" />
	</ItemGroup>

</Project>
